# JSON service-account Google dalam satu baris. Jangan commit nilai aslinya.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=1phlqxDUgcoYHNYqeHdsvbzPTT_Sh0Ve8
# Kunci privat buatan sendiri untuk membatasi akses endpoint upload.
STORAGE_UPLOAD_KEY=
# Adapter Node harus lebih besar dari batas file + overhead multipart.
BODY_SIZE_LIMIT=106954752
# Client ID Google (identifier publik). Hanya wajib untuk alur OAuth; kosong untuk service account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lokasi refresh token hasil consent OAuth. Default /app/.refresh-token (layer
# container — HILANG saat container di-recreate). Di produksi arahkan ke bind
# mount, mis. /app/data/.refresh-token, supaya token selamat tiap rebuild.
REFRESH_TOKEN_FILE=
